# ---------------------------------------------------------------------------
# Billing gate (CPO side)
#
# These four are read straight from the environment by 00_Base/src/util/Consts.ts
# rather than through the zod OcpiConfig schema: the mappers that need them are
# static and hold no config handle. A malformed value is warned about and falls
# back to the default — it is never silently accepted.
# ---------------------------------------------------------------------------

# Session energy (kWh) that must be delivered before charging time is billable.
# MUST match the gateway's BILLING_ENERGY_THRESHOLD_KWH — the same charger is
# billed by both, and a driver on the app and a roaming driver must not get
# different answers. 0 disables the gate.
BILLING_ENERGY_THRESHOLD_KWH=0.02

# Power floor (kW) published to roaming partners as TariffRestrictions.min_power
# on the TIME price component, so a partner pricing off our tariff reaches the
# same answer our CDR does. 0 omits the restriction entirely.
BILLING_MIN_POWER_KW=0.1

# Idle (parking) rate per minute, as JSON keyed by station id. Absent or zero
# means no parking charge, which is the default.
#
# DUPLICATION WARNING: the authoritative rate lives on the gateway, as
# citrine_extended_location.idle_rate. Keep the two in sync by hand; if they
# drift, a roaming driver and one of our own app users at the same charger get
# different idle bills.
# BILLING_IDLE_RATE_PER_MIN={"55102-002":0.5}

# Grace period before parking becomes billable, in minutes, keyed by station id.
# Defaults to 30 for any station not listed.
# BILLING_IDLE_BUFFER_MINUTES={"55102-002":30}
